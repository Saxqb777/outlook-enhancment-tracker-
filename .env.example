# Postgres connection string (Neon pooled connection string in production)
DATABASE_URL=postgres://user:password@localhost:5432/agthia

# One-time code needed on /setup to create the Lead account.
# Use a long random value. Setup stops working once the Lead exists.
SETUP_CODE=change-me

# Claude API key used to read emails into cases (server only).
ANTHROPIC_API_KEY=

# The site's own address, used when making invite, join and reset links (recommended in production).
APP_URL=https://your-site.example.com

# Private file storage for attachments (Vercel Blob). Leave empty locally: files are then kept in the database.
BLOB_READ_WRITE_TOKEN=
